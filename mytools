#!/usr/bin/env python3
"""mytools -- a small reimplementation of a subset of bedtools.

Thin entry point. Everything lives in mytoolslib/; see SPEC.md for the contract.
"""

import os
import sys

# realpath so that invoking through a symlink on PATH still finds mytoolslib.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from mytoolslib.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv))
