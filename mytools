#!/usr/bin/env python3
"""mytools — a small reimplementation of a subset of bedtools.

Only --version works so far. Subcommands (sort, merge, intersect, subtract) have
their own issues; see SPEC.md once it exists.
"""

import sys

VERSION = "0.1.0"

USAGE = f"""\
usage: mytools <command> [options]

mytools {VERSION}

No subcommands are implemented yet.

options:
  --version   print the version and exit
  -h, --help  print this message and exit
"""


def main(argv):
    args = argv[1:]
    if not args:
        sys.stderr.write(USAGE)
        return 2
    if args[0] == "--version":
        print(f"mytools {VERSION}")
        return 0
    if args[0] in ("-h", "--help"):
        sys.stdout.write(USAGE)
        return 0
    sys.stderr.write(f"mytools: unknown command or option: {args[0]}\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
